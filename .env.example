# Resend API Key for Transactional Emails (Quote & Contact Forms)
RESEND_API_KEY=re_xxxxxxxxx

# Destination email for new leads, RFQs, and contact form submissions
SALES_NOTIFICATION_EMAIL=honeywellhydraulics@gmail.com

# Public Agent ID used by the client-side conversational AI widget
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxx

# ElevenLabs Secret API Key (for server-side integration / TTS API requests)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 (GA4) Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager (GTM) Container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Search Console Site Verification Token (HTML Tag verification content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps API Key (for embedded maps / Places Autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# Google AI Studio / Gemini API Key (e.g., AIzaSy...)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# Google Cloud Platform API Key
GOOGLE_CLOUD_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxx

# Service account email from Google Cloud Console
GOOGLE_INDEXING_CLIENT_EMAIL=indexing-service-account@your-gcp-project.iam.gserviceaccount.com

# Private key string from service account JSON (with escaped newlines \n)
GOOGLE_INDEXING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
